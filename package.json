{
  "name": "ai-proxy-structured",
  "version": "1.0.0",
  "description": "Multi-Provider AI Proxy following Structured-Prompt-Driven Development pattern",
  "packageManager": "pnpm@11.28.8+sha512.f6988a32046b9a3f78d7d7ee0747926bbe905ff9dff73bf19abb87bd7d1906a2ac90d93f73be32b5f9e14c2899569bcb0c9c5ec8a19e083f5d71bbab6dd9e0b8",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "wrangler dev",
    "validate": "pnpm run lint:lockfile && pnpm run lint && pnpm run typecheck && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:lockfile": "pnpm install --lockfile-only --frozen-lockfile --ignore-scripts --optimistic-repeat-install",
    "prepare": "husky",
    "deploy": "pnpm run validate && echo 'fake deploying comand, replace with actual deploy command'",
    "deploy:cloudflare": "bash scripts/deploy-cloudflare.sh"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "oxlint --fix",
      "sh -c 'tsc --noEmit' --"
    ]
  },
  "dependencies": {
    "hono": "^4.12.27",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.18",
    "@cloudflare/workers-types": "^4.20260629.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@types/node": "26.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "oxlint": "^1.71.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "semantic-release": "^25.0.5",
    "typescript": "6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.105.0"
  }
}
