{
  "name": "ai-proxy-structured",
  "version": "1.0.0",
  "description": "Multi-Provider AI Proxy following Structured-Prompt-Driven Development pattern",
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "wrangler dev",
    "validate": "pnpm run lint:lockfile && pnpm run lint && pnpm run typecheck && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:lockfile": "pnpm install --lockfile-only --frozen-lockfile --ignore-scripts --optimistic-repeat-install",
    "prepare": "husky",
    "deploy": "pnpm run validate && echo 'fake deploying comand, replace with actual deploy command'",
    "deploy:cloudflare": "bash scripts/deploy-cloudflare.sh"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "oxlint --fix",
      "sh -c 'tsc --noEmit' --"
    ]
  },
  "dependencies": {
    "hono": "^4.13.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260809.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.77.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "semantic-release": "^25.0.9",
    "typescript": "7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
