{
  "name": "ai-proxy-structured",
  "version": "1.0.0",
  "description": "Multi-Provider AI Proxy following Structured-Prompt-Driven Development pattern",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "pnpm run validate && echo 'fake deploying comand, replace with actual deploy command'",
    "deploy:cloudflare": "bash scripts/deploy-cloudflare.sh",
    "validate": "pnpm run lint:lockfile && pnpm run lint && pnpm run typecheck && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:lockfile": "lockfile-lint --path pnpm-lock.yaml --type pnpm --allowed-hosts pnpm --validate-https --validate-integrity --validate-package-name --validate-checksum"
  },
  "dependencies": {
    "hono": "^4.12.21"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.8",
    "@cloudflare/workers-types": "^4.20260521.1",
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "lockfile-lint": "5.0.0",
    "oxlint": "^1.66.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.93.1"
  },
  "volta": {
    "node": "24.16.0"
  }
}
