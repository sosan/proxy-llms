{
  "name": "ai-proxy-structured",
  "version": "1.0.0",
  "description": "Multi-Provider AI Proxy following Structured-Prompt-Driven Development pattern",
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "wrangler dev",
    "release": "release-it",
    "release:minor": "release-it minor",
    "release:major": "release-it major",
    "validate": "pnpm run lint:lockfile && pnpm run lint && pnpm run typecheck && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:lockfile": "pnpm install --lockfile-only --frozen-lockfile --ignore-scripts --optimistic-repeat-install",
    "deploy": "pnpm run validate && echo 'fake deploying comand, replace with actual deploy command'",
    "deploy:cloudflare": "bash scripts/deploy-cloudflare.sh"
  },
  "dependencies": {
    "hono": "^4.12.22"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.9",
    "@cloudflare/workers-types": "^4.20260522.1",
    "@release-it/bumper": "^7.0.5",
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "oxlint": "^1.66.0",
    "release-it": "^20.0.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.94.0"
  }
}
