# npm security best practices
# Source: https://github.com/lirantal/npm-security-best-practices

# SECURITY: do not run any lifecycle scripts (postinstall) etc
ignore-scripts=true

# SECURITY: reject git-source dependencies (git+ssh:// etc)
allow-git=none

# SECURITY: block packages newer than 30 days
min-release-age=30

# SECURITY: fail on engine mismatch (prevents installing with unsupported Node versions)
engine-strict=true

# SECURITY: audit signatures on every install
audit=true

# SECURITY: do not fund
fund=false
