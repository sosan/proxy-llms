{
    "autoMemoryEnabled": true,
    "alwaysThinkingEnabled": true,
    "showThinkingSummaries": true,
    "env": {
        "CLAUDE_CODE_AUTO_CONNECT_IDE": "true",
        "DISABLE_ERROR_REPORTING": "1",
        "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
        "ANTHROPIC_BASE_URL": "http://localhost:8787"
    },
    "permissions": {
        "allow": [
            "Bash(cat:*)",
            "Bash(find:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git status:*)",
            "Bash(ls:*)",
            "Bash(pnpm run typecheck)",
            "Bash(pnpm run test)",
            "Bash(pnpm run test:watch)",
            "Bash(pnpm run test:coverage)",
            "Bash(pnpm run build)",
            "Bash(rg:*)",
            "Bash(sed:*)",
            "Bash(wc:*)",
            "Bash(node --version)",
            "Bash(pnpm --version)",
            "Bash(npx wrangler --version)",
            "Edit(.claude/**)",
            "Edit(CLAUDE.md)",
            "Edit(src/config/**)",
            "Edit(src/controllers/**)",
            "Edit(src/durable-objects/**)",
            "Edit(src/errors/**)",
            "Edit(src/interfaces/**)",
            "Edit(src/metrics/**)",
            "Edit(src/parsers/**)",
            "Edit(src/providers/**)",
            "Edit(src/routes/**)",
            "Edit(src/transformers/**)",
            "Edit(src/utils/**)",
            "Edit(src/__tests__/**)",
            "Edit(src/server.ts)",
            "Edit(.github/**)",
            "Edit(.devcontainer/**)",
            "Edit(.editorconfig)",
            "Edit(package.json)",
            "Edit(tsconfig.json)",
            "Edit(vitest.config.ts)",
            "Edit(wrangler.toml)",
            "Edit(README.md)",
            "Edit(test-*.js)",
            "Read(.claude/**)",
            "Read(src/config/**)",
            "Read(src/controllers/**)",
            "Read(src/durable-objects/**)",
            "Read(src/errors/**)",
            "Read(src/interfaces/**)",
            "Read(src/metrics/**)",
            "Read(src/parsers/**)",
            "Read(src/providers/**)",
            "Read(src/routes/**)",
            "Read(src/transformers/**)",
            "Read(src/utils/**)",
            "Read(src/__tests__/**)",
            "Read(src/server.ts)",
            "Read(.github/**)",
            "Read(.npmrc)",
            "Read(.pnpm-workspace.yaml)",
            "Read(.devcontainer/**)",
            "Read(.editorconfig)",
            "Read(package.json)",
            "Read(tsconfig.json)",
            "Read(vitest.config.ts)",
            "Read(wrangler.toml)",
            "Read(README.md)",
            "Read(test-*.js)",
            "WebFetch(domain:blog.marcolancini.it)",
            "WebFetch(domain:developers.cloudflare.com)",
            "WebFetch(domain:docs.claude.com)",
            "WebFetch(domain:docs.nvidia.com)",
            "WebFetch(domain:github.com)",
            "WebFetch(domain:openai.com)",
            "WebFetch(domain:platform.openai.com)",
            "WebSearch"
        ],
        "deny": [
            "Bash(rm -rf *)",
            "Bash(rm -fr *)",
            "Bash(sudo *)",
            "Bash(git push --force*)",
            "Bash(git push *--force*)",
            "Bash(git reset --hard*)",
            "Bash(git clean -fd*)",
            "Bash(pnpm run deploy)",
            "Bash(wrangler deploy*)",
            "Bash(pnpm publish)",
            "Bash(pnpm unpublish)",
            "Bash(chmod 777*)",
            "Bash(chmod -R 777*)",
            "Edit(.env)",
            "Edit(.local)",
            "Edit(~/.ssh/**)",
            "Edit(~/.aws/**)",
            "Edit(~/.config/gh/**)",
            "Edit(~/.git-credentials)",
            "Read(.env)",
            "Read(.local)",
            "Read(~/.ssh/**)",
            "Read(~/.aws/**)",
            "Read(~/.config/gh/**)",
            "Read(~/.git-credentials)",
            "Edit(.npmrc)",
            "Edit(.pnpm-workspace.yaml)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "CMD=$(jq -r '.tool_input.command'); if echo \"$CMD\" | grep -qE 'rm[[:space:]]+-[^[:space:]]*r[^[:space:]]*f'; then echo 'BLOCKED: destructive rm command' >&2; exit 2; fi"
                    },
                    {
                        "type": "command",
                        "command": "CMD=$(jq -r '.tool_input.command'); if echo \"$CMD\" | grep -qE 'git[[:space:]]+reset[[:space:]]+--hard'; then echo 'BLOCKED: git reset --hard must be explicitly requested by the user' >&2; exit 2; fi"
                    },
                    {
                        "type": "command",
                        "command": "CMD=$(jq -r '.tool_input.command'); if echo \"$CMD\" | grep -qE '(wrangler|pnpm)[[:space:]].*deploy'; then echo 'BLOCKED: deploy commands must be run by the user intentionally' >&2; exit 2; fi"
                    },
                    {
                        "type": "command",
                        "command": "CMD=$(jq -r '.tool_input.command'); if echo \"$CMD\" | grep -qE 'chmod[[:space:]]+777'; then echo 'BLOCKED: chmod 777 is unsafe, use more restrictive permissions' >&2; exit 2; fi"
                    }
                ]
            },
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/warn-sensitive-files.sh"
                    }
                ]
            }
        ]
    },
    "spinnerVerbs": {
        "mode": "replace",
        "verbs": [
            "Resolving model aliases",
            "Checking Worker routes",
            "Forwarding tokens",
            "Reading upstream headers",
            "Keeping streams warm",
            "Inspecting provider config",
            "Typechecking the proxy",
            "Running tests",
            "Watching for timeouts",
            "Processing provider requests",
            "Managing Durable Objects",
            "Optimizing streaming responses"
        ]
    }
}
